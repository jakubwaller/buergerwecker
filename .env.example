MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=hallo@buergerwecker.de
MAILJET_FROM_NAME=Bürgerwecker
# Optional. Where subscriber replies go. Lets the From be a sending subdomain
# that doesn't receive mail; replies route here instead. Leave blank to omit.
REPLY_TO_EMAIL=termine@jakubwaller.eu
# Mailjet daily cap (free tier = 200/day). Enforced together with the hourly
# cap below — whichever is tighter wins. During the new-sender warm-up the
# hourly throttle binds; once Mailjet lifts it, this daily cap takes over. Set
# high after upgrading to a paid Mailjet plan.
MAILJET_DAILY_QUOTA=200
# Optional fallback providers. A provider sends only when its key is set AND
# it is named in EMAIL_PROVIDER_ORDER below — a key alone is inert, so one can
# be configured ahead of a smoke test without routing live mail through it.
# Leave a key blank to disable that provider outright; with no fallback in the
# order, Mailjet failures surface as MailFailed instead of falling back
# silently. All configured providers are EU providers.
BREVO_API_KEY=
SWEEGO_API_KEY=
# Quota-aware delivery caps. Notification digests are sent in batches (Mailjet
# up to 50/call; Brevo and Sweego one message per call) and never past these
# rolling-window limits — the overflow is deferred to a later cycle. Defaults
# match the free tiers (Brevo 300/day; Sweego 100/day; Mailjet 10/hour warm-up
# throttle + 200/day above). Raise these to match your plan after upgrading.
BREVO_DAILY_QUOTA=300
SWEEGO_DAILY_QUOTA=100
MAILJET_HOURLY_QUOTA=10
# Monthly caps, display-only: the /admin "Email quota" section shows
# month-to-date sends against these (free tiers: Mailjet 6000/mo, Brevo
# 9000/mo, Sweego 3000/mo). They do NOT gate delivery — the rolling-window
# caps above do.
MAILJET_MONTHLY_QUOTA=6000
BREVO_MONTHLY_QUOTA=9000
SWEEGO_MONTHLY_QUOTA=3000
# Order providers are tried — for notification digests and the transactional
# fallback chain alike. Mailjet-first routes notification volume through
# Mailjet so its account sees traffic (needed to get the new-sender throttle
# lifted); the rest take the overflow, in order. Prove a new provider before
# naming it here (see docs/DEPLOY.md). Runtime-configurable, no redeploy.
EMAIL_PROVIDER_ORDER=mailjet,brevo,sweego
# Delivery feedback (bounces, spam complaints). Providers report these
# asynchronously over a webhook — the send call itself returns 200 and says
# nothing — so without this the service mails dead addresses forever and the
# bounce rate is charged against the sending domain until large receivers
# throttle it. Endpoint: POST /webhooks/<provider>/<WEBHOOK_SECRET>. Blank
# disables it (the endpoint answers 503 and /admin says so). Generate with
# `openssl rand -hex 24`; per-provider dashboard setup is in docs/DEPLOY.md.
WEBHOOK_SECRET=
# Optional. Sweego additionally signs its payloads; set the webhook secret
# from its dashboard and the HMAC is required on top of the URL secret.
SWEEGO_WEBHOOK_SECRET=
# Consecutive soft bounces (full mailbox, greylisting) before an address is
# retired for good. Any confirmed delivery resets the run. 0 counts without
# ever suppressing.
SOFT_BOUNCE_SUPPRESS_THRESHOLD=5
# Email DEVELOPER_EMAIL once/day when the COMBINED rolling-24h usage across
# every provider that can send crosses this percent of the summed daily caps,
# or whenever notifications get deferred for lack of quota — the cue to switch
# to a paid plan.
QUOTA_ALERT_THRESHOLD_PCT=80
TOKEN_SECRET_PRIMARY=
TOKEN_SECRET_PREVIOUS=
ADMIN_TOKEN=
# Public site URL — all links in emails (confirm / manage / unsubscribe) are
# built from this. The From domain above must stay verified with EVERY
# configured provider (Mailjet, Brevo, Sweego), or fallback sends get
# rejected.
PUBLIC_BASE_URL=https://buergerwecker.de
DEDUP_WINDOW_HOURS=24
RATE_LIMIT_MINUTES=15
SUBSCRIPTION_TTL_DAYS=90
# Subscriptions to a service flagged `sensitive_services` in the catalog hold
# special-category data (Art. 9 GDPR) and expire sooner. Optional; 30 if unset.
SENSITIVE_SUBSCRIPTION_TTL_DAYS=30
RENEWAL_REMINDER_DAYS_BEFORE=10
# One poll plan is needed per distinct appointment type per city (location
# variety collapses into a single "all" plan). Must cover the LARGEST tenant:
# Leipzig has 15 types, Dresden 16 — so 16 lets every type be watched without
# /subscribe ever returning 503 for a rare type. Lower it only to cap polling
# work at the cost of turning away rarer appointment types.
MAX_PLANS_PER_CITY=16
PARSER_CANARY_THRESHOLD_HOURS=2
# Raised from 5: many readers share one public IP behind mobile-carrier CGNAT,
# so a low per-IP cap turns away legitimate sign-ups during a traffic spike.
# Abuse is still bounded by SUBSCRIBE_RATELIMIT_PER_EMAIL_PER_DAY below.
SUBSCRIBE_RATELIMIT_PER_IP_PER_HOUR=30
# 5, not 1: one address may legitimately create several subscriptions in one
# sitting (three tenants, plus separate Anliegen per city). Counts every row
# created in the last 24h, including unconfirmed and soft-deleted ones.
SUBSCRIBE_RATELIMIT_PER_EMAIL_PER_DAY=5
DEVELOPER_EMAIL=
KOFI_URL=https://ko-fi.com/jakubwaller
DB_PATH=/data/app.db
CATALOG_SYNC_ENABLED=1
